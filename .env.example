# Copy to .env and fill in the key for whichever provider you use.
# .env itself is gitignored — never commit real keys.
#
# CLAUDE.md rule 5: the LLM is never load-bearing. Every command works
# with `--llm off` (the default) and no key at all — this is only needed
# for `--llm on` or a live /ask, /api/ask answer.

# --- Anthropic (default provider) ---
ANTHROPIC_API_KEY=

# --- Gemini (set RECON_LLM_PROVIDER=gemini to use it instead) ---
GEMINI_API_KEY=

# anthropic | gemini — which LLMClient strategy backs tier4/Q&A.
# Optional; defaults to anthropic if unset.
RECON_LLM_PROVIDER=
